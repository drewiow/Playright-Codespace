{
    "name": "Send a system announcement",
    "description": "Creates a system announcement",
    "inputs": [
        {
            "key": "from",
            "label": "From",
            "type": "date",
            "required": true,
            "placeholder": "e.g. 14/01/2026"
        },
        {
            "key": "until",
            "label": "Until",
            "type": "date",
            "required": true,
            "placeholder": "e.g. 21/01/2026"
        },
        {
            "key": "to",
            "label": "To",
            "type": "text",
            "required": false,
            "placeholder": "e.g. P, V, C"
        },
        {
            "key": "title",
            "label": "Title",
            "type": "text",
            "required": true,
            "placeholder": "e.g. My announcement"
        },
        {
            "key": "body",
            "label": "Body",
            "type": "textarea",
            "required": true,
            "placeholder": "e.g. This is my announcement"
        }
    ]
}